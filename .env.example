# Addresses are resolved inside the Compose network.
AIRTRAFFIC_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
AIRTRAFFIC_RAW_TOPIC=airtraffic.raw.replay.v1
AIRTRAFFIC_RAW_ARCHIVE=hdfs://namenode:9000/airtraffic/bronze/raw-adsb-v1
AIRTRAFFIC_RAW_CHECKPOINT=hdfs://namenode:9000/airtraffic/checkpoints/archive-raw-adsb-v1
AIRTRAFFIC_STREAMING_ROOT=hdfs://namenode:9000/airtraffic/streaming
AIRTRAFFIC_RAW_AVRO=/workspace/data/raw/raw20150421_sample.avro

# Standalone raw importer: export these into its process environment.
# Compose does not automatically forward these to existing Spark jobs.
AIRTRAFFIC_MINIO_ENDPOINT=localhost:9000
AIRTRAFFIC_MINIO_BUCKET=airtraffic-raw
AIRTRAFFIC_MINIO_ACCESS_KEY=
AIRTRAFFIC_MINIO_SECRET_KEY=

# Primary OpenSky state collector; requires OpenSky written authorization.
AIRTRAFFIC_STATES_TOPIC=airtraffic.states.opensky.v1
AIRTRAFFIC_OPENSKY_CLIENT_ID=
AIRTRAFFIC_OPENSKY_CLIENT_SECRET=

AIRTRAFFIC_STATES_BUCKET=airtraffic-states
